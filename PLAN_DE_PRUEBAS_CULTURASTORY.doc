\par
\pard\li720\tx720\fi-360\bullet\tab Autenticaci\u243?n y registro\par
\pard\li720\tx720\fi-360\bullet\tab Gesti\u243?n de perfil del estudiante\par
\pard\li720\tx720\fi-360\bullet\tab B\u250?squeda de instituciones\par
