\pard\li720\tx720\fi-360\bullet\tab Panel docente\par
\pard\li720\tx720\fi-360\bullet\tab Revisi\u243?n, aprobaci\u243?n y rechazo de narrativas\par
\pard\li720\tx720\fi-360\bullet\tab Gesti\u243?n de usuarios por administrador\par
\pard\li720\tx720\fi-360\bullet\tab Biblioteca cultural y vistas p\u250?blicas\par
\pard\li720\tx720\fi-360\bullet\tab Reproductor de narrativa\par
\pard\li720\tx720\fi-360\bullet\tab Storyboard y recursos multimedia\par
\pard\li720\tx720\fi-360\bullet\tab Integraci\u243?n frontend-backend\par
\pard\li720\tx720\fi-360\bullet\tab Integridad de datos entre UI, API y base de datos\par
\par
\pard\sa180\sb140\b\f1\fs26 3.2 Fuera de alcance inicial\b0\f0\fs22\par
\par
\pard\li720\tx720\fi-360\bullet\tab Exactitud acad\u233?mica de modelos de IA a nivel ling\u252?\u237?stico profundo\par
\pard\li720\tx720\fi-360\bullet\tab Pruebas de compatibilidad con navegadores obsoletos\par
