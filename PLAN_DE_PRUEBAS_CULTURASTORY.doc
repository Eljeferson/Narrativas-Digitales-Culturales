\pard\sa180\sb140\b\f1\fs26 5. Estrategia general de pruebas\b0\f0\fs22\par
\par
\pard\sa60 Se recomienda ejecutar las pruebas en las siguientes capas:\par
\par
\pard\li720\tx720\fi-360 1.\tab Pruebas unitarias\par
\pard\li720\tx720\fi-360 2.\tab Pruebas de integraci\u243?n\par
\pard\li720\tx720\fi-360 3.\tab Pruebas funcionales de interfaz\par
\pard\li720\tx720\fi-360 4.\tab Pruebas end-to-end\par
\pard\li720\tx720\fi-360 5.\tab Pruebas de regresi\u243?n\par
\pard\li720\tx720\fi-360 6.\tab Pruebas de rendimiento\par
\pard\li720\tx720\fi-360 7.\tab Pruebas de calidad no funcional\par
\par
\pard\sa60 La estrategia sugerida es:\par
\par
\pard\li720\tx720\fi-360\bullet\tab Automatizar primero backend y l\u243?gica cr\u237?tica.\par
\pard\li720\tx720\fi-360\bullet\tab Automatizar despu\u233?s flujos cr\u237?ticos del frontend.\par
\pard\li720\tx720\fi-360\bullet\tab Mantener una bater\u237?a m\u237?nima de regresi\u243?n manual para release.\par
\pard\li720\tx720\fi-360\bullet\tab Ejecutar rendimiento sobre endpoints cr\u237?ticos y flujos de mayor uso.\par
\par
\pard\sa60 ---\par
\par
